<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springaicommunity</groupId>
		<artifactId>spring-ai-typesafe-parent</artifactId>
		<version>0.2.0</version>
	</parent>

	<artifactId>typesafe-spring-ai</artifactId>
	<name>Spring AI TypeSafe :: Spring AI</name>
	<description>Spring AI advisors, RAG post-processors and a tool index backed by the TypeSafe AI System One (Jev) model</description>

	<!--
		Repeated rather than inherited.
	-->
	<url>https://github.com/spring-ai-community/spring-ai-typesafe</url>

	<scm>
		<url>https://github.com/spring-ai-community/spring-ai-typesafe</url>
		<connection>git://github.com/spring-ai-community/spring-ai-typesafe.git</connection>
		<developerConnection>git@github.com:spring-ai-community/spring-ai-typesafe.git</developerConnection>
	</scm>

	<organization>
		<name>Spring AI Community</name>
		<url>https://github.com/spring-ai-community</url>
	</organization>

	<licenses>
		<license>
			<name>Apache License 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Christian Tzolov</name>
		</developer>
	</developers>

	<issueManagement>
		<system>Github Issues</system>
		<url>https://github.com/spring-ai-community/spring-ai-typesafe/issues</url>
	</issueManagement>

	<ciManagement>
		<system>Github Actions</system>
		<url>https://github.com/spring-ai-community/spring-ai-typesafe/actions</url>
	</ciManagement>

	<dependencies>
		<dependency>
			<groupId>org.springaicommunity</groupId>
			<artifactId>typesafe-java-sdk</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-client-chat</artifactId>
		</dependency>

		<!--
			Optional integrations. The judge and the advisors need neither, so an application
			that does not do RAG or tool search never sees these classes on its classpath and
			never pays for the dependency. Declare the matching artifact yourself to use
			org.springaicommunity.typesafe.rag or .toolsearch.
		-->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-rag</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-tool-search-tool</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.skyscreamer</groupId>
			<artifactId>jsonassert</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
