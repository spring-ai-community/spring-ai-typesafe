<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springaicommunity</groupId>
		<artifactId>spring-ai-typesafe-parent</artifactId>
		<version>0.4.0-SNAPSHOT</version>
	</parent>

	<artifactId>decision-test</artifactId>
	<name>Spring AI TypeSafe :: Decision Test</name>
	<description>AssertJ assertions and a JUnit Jupiter extension for testing with the TypeSafe AI System One (Jev) model</description>

	<!--
		Repeated rather than inherited.
	-->
	<url>https://github.com/spring-ai-community/spring-ai-typesafe</url>

	<scm>
		<url>https://github.com/spring-ai-community/spring-ai-typesafe</url>
		<connection>git://github.com/spring-ai-community/spring-ai-typesafe.git</connection>
		<developerConnection>git@github.com:spring-ai-community/spring-ai-typesafe.git</developerConnection>
	</scm>

	<organization>
		<name>Spring AI Community</name>
		<url>https://github.com/spring-ai-community</url>
	</organization>

	<licenses>
		<license>
			<name>Apache License 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Christian Tzolov</name>
		</developer>
	</developers>

	<issueManagement>
		<system>Github Issues</system>
		<url>https://github.com/spring-ai-community/spring-ai-typesafe/issues</url>
	</issueManagement>

	<ciManagement>
		<system>Github Actions</system>
		<url>https://github.com/spring-ai-community/spring-ai-typesafe/actions</url>
	</ciManagement>

	<dependencies>
		<dependency>
			<groupId>org.springaicommunity</groupId>
			<artifactId>typesafe-spring-ai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
		</dependency>

		<!--
			Optional: the assertions work under any test framework, and only @DecisionTest and
			DecisionExtension need JUnit Jupiter. A project that uses them has it already.
		-->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-testkit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
